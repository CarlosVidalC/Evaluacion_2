<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" prefHeight="560" prefWidth="780"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.viviendas.controller.MainController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Administradora de viviendas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar"/>
        <TextField fx:id="txtBuscar" promptText="Código, tipo, habitaciones o superficie" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="Nueva vivienda"/>
    </HBox>

    <TableView fx:id="tblViviendas" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo"/>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colSuperficie" text="Superficie (m²)"/>
            <TableColumn fx:id="colHabitaciones" text="Habitaciones"/>
            <TableColumn fx:id="colCosto" text="Costo arriendo"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnEliminar" text="Eliminar"/>
    </HBox>

    <Label fx:id="lblMensaje" wrapText="true" minHeight="44" maxWidth="Infinity"
           style="-fx-border-color: #bdbdbd; -fx-padding: 8;"/>
</VBox>
