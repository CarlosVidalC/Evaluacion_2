<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" prefWidth="640"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.viviendas.controller.RegistroController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Registro de vivienda" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="8">

        <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbTipo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>


        <Label text="Código de propiedad" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Superficie (m²)" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtSuperficie" GridPane.columnIndex="3" GridPane.rowIndex="1"/>


        <Label text="Habitaciones" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtHabitaciones" GridPane.columnIndex="1" GridPane.rowIndex="2"/>


        <Label text="Piso (departamento)" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtPiso" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <CheckBox fx:id="chkGastoComun" text="Gasto común al día"
                  GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento asignado"
                  GridPane.columnIndex="3" GridPane.rowIndex="3"/>


        <CheckBox fx:id="chkPatio" text="Casa con patio"
                  GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cerrar"/>
        <Button fx:id="btnRegistrar" text="Registrar" defaultButton="true"/>
    </HBox>

    <Label fx:id="lblMensaje" wrapText="true" minHeight="44" maxWidth="Infinity"
           style="-fx-border-color: #bdbdbd; -fx-padding: 8;"/>
</VBox>
